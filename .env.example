# Local defaults for development only. Copy to .env and change before sharing an environment.

COMPOSE_PROJECT_NAME=tracelake

# Kafka (KRaft). Any base64 encoded 16 byte UUID works.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# MinIO (S3 API for the lakehouse)
MINIO_ROOT_USER=tracelake
MINIO_ROOT_PASSWORD=tracelake-local-secret

# Orders service database
ORDERS_DB_NAME=orders
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders-local-secret

# Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow-local-secret

# Airflow web login and keys
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin-local-secret
AIRFLOW_FERNET_KEY=7y27qK0IhiFvmKV35iRCicESxkhrvrt0OS0i2qbCcv8=
AIRFLOW_SECRET_KEY=fa68c101ae793f91d5669e22c79c7f843390dff75db41231

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-local-secret

# Load generator
K6_VUS=5
K6_DURATION=2m
